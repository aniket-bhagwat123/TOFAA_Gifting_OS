{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "tofaa-backend": {
      "root": "backend",
      "framework": "fastapi"
    },
    "frontend": {
      "root": "frontend",
      "framework": "nextjs"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": { "service": "tofaa-backend" }
    },
    {
      "source": "/health",
      "destination": { "service": "tofaa-backend" }
    },
    {
      "source": "/health/(.*)",
      "destination": { "service": "tofaa-backend" }
    },
    {
      "source": "/(.*)",
      "destination": { "service": "frontend" }
    }
  ]
}
